<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ComPortWidget</AssemblyName>
    <StartupObject>ComPortWidget.App.Program</StartupObject>
    <RootNamespace>ComPortWidget.App</RootNamespace>
    <!-- 버전과 제품 정보. 릴리스 스크립트가 -p:Version=... 으로 덮어쓴다 -->
    <Version>0.1.0</Version>
    <Product>COM Port Widget</Product>
    <Company>Nerdvana Inc.</Company>
    <Copyright>Copyright (c) 2026 Nerdvana Inc.</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <!-- 단일 exe 압축: 173 MB -> 약 75 MB, 시작 시간은 약 0.25초 늘어난다(README 참조) -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF와 WinForms의 같은 이름 형식이 충돌하지 않게 암시적 using을 뺀다 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ComPortWidget.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ComPortWidget.Core\ComPortWidget.Core.csproj" />
    <ProjectReference Include="..\ComPortWidget.Platform\ComPortWidget.Platform.csproj" />
  </ItemGroup>

</Project>
