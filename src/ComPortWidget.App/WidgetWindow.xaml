<Window x:Class="ComPortWidget.App.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COM Port Widget"
        WindowStyle="None" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Width="380" Height="420" MinWidth="260" MinHeight="140"
        Background="#1E2127" Foreground="#E6E8EB"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="#9AA3AF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2F37"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="RowMenu">
            <MenuItem Click="CopyPort_Click"/>
            <MenuItem Click="EditMemo_Click"/>
            <MenuItem Click="DeviceInfo_Click"/>
        </ContextMenu>

        <DataTemplate x:Key="RowTemplate">
            <Border x:Name="Card" Margin="6,2" Padding="8,5" CornerRadius="6" Background="Transparent"
                    ContextMenu="{StaticResource RowMenu}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,6,8,0" VerticalAlignment="Top" Fill="#2FBF8F"/>
                    <StackPanel Grid.Column="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PortName}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="Sep" Grid.Column="1" Text=" · " Foreground="#A3ACB6" Visibility="Collapsed"/>
                            <Grid x:Name="MemoArea" Grid.Column="2" Background="Transparent" Margin="6,0,0,0"
                                  MouseLeftButtonUp="MemoArea_MouseLeftButtonUp">
                                <TextBlock x:Name="MemoText" Text="{Binding Memo}" TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" Visibility="Collapsed"/>
                                <TextBlock x:Name="AddMemo" Text="{Binding AddMemoText}" Foreground="#A3ACB6"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBox x:Name="EditBox" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="500" Visibility="Collapsed" Background="#12151A" Foreground="#E6E8EB"
                                         CaretBrush="#E6E8EB" BorderBrush="#2FBF8F" Padding="2,0"
                                         IsVisibleChanged="EditBox_IsVisibleChanged"
                                         DataObject.Pasting="EditBox_Pasting"
                                         PreviewKeyDown="EditBox_PreviewKeyDown"
                                         LostKeyboardFocus="EditBox_LostKeyboardFocus"/>
                            </Grid>
                            <Border x:Name="Badge" Grid.Column="3" Margin="8,0,0,0" Padding="6,0" CornerRadius="3"
                                    Background="#2FBF8F" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="{Binding NewText}" FontSize="10" FontWeight="Bold" Foreground="#0E1F1A"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Line2}" ToolTip="{Binding Line2}" FontSize="11" Foreground="#A3ACB6"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                        <Setter TargetName="Card" Property="Background" Value="#17443A"/>
                        <Setter TargetName="Badge" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                        <Setter TargetName="Card" Property="TextElement.Foreground" Value="#A3ACB6"/>
                        <Setter TargetName="Dot" Property="Fill" Value="#6B7480"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasMemo}" Value="True">
                        <Setter TargetName="Sep" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="MemoText" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="AddMemo" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                        <Setter TargetName="Sep" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="MemoText" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="AddMemo" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="EditBox" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="#2E333B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="Header" Background="#1E2127" Margin="10,8,6,4" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#E0A93B" FontSize="11"
                           Margin="10,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusText}"/>
                <Button x:Name="GearButton" Grid.Column="2" Style="{StaticResource FlatButton}" Content="⚙"
                        Click="Gear_Click"/>
                <Button x:Name="HideButton" Grid.Column="3" Style="{StaticResource FlatButton}" Content="✕"
                        Click="Hide_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Connected}" ItemTemplate="{StaticResource RowTemplate}"
                                  Focusable="False"/>
                    <TextBlock Text="{Binding EmptyText}" Foreground="#A3ACB6" Margin="16,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasConnected}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Background="Transparent" Margin="6,6,6,2" Padding="8,3" Cursor="Hand"
                            Visibility="{Binding HasDisconnected, Converter={StaticResource BoolToVis}}"
                            MouseLeftButtonUp="DisconnectedToggle_MouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Arrow" Foreground="#A3ACB6" Width="14"/>
                            <TextBlock Text="{Binding DisconnectedText}" Foreground="#A3ACB6"/>
                        </StackPanel>
                    </Border>
                    <ItemsControl x:Name="DisconnectedList" ItemsSource="{Binding Disconnected}"
                                  ItemTemplate="{StaticResource RowTemplate}" Focusable="False"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
