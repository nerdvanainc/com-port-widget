<Window x:Class="ComPortWidget.App.ThemedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        SizeToContent="Height" Width="440" MinWidth="320" MaxWidth="640" MaxHeight="640"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" MaxHeight="480">
            <!-- 읽기 전용 TextBox: 내용을 선택해 복사할 수 있다 -->
            <TextBox x:Name="Message" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                     Padding="0" Foreground="{StaticResource TextBrush}" IsReadOnlyCaretVisible="False"/>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="YesButton" MinWidth="84" Click="Yes_Click" Style="{StaticResource PrimaryButton}"
                    AutomationProperties.AutomationId="DialogYesButton"/>
            <Button x:Name="NoButton" MinWidth="84" Margin="8,0,0,0" Click="No_Click" IsCancel="True"
                    AutomationProperties.AutomationId="DialogNoButton"/>
        </StackPanel>
    </Grid>
</Window>
