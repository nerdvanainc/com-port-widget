<Window x:Class="ComPortWidget.App.ResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COM ports cleanup" Width="560" Height="640" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Intro" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
            <Button x:Name="RetryButton" Click="Retry_Click" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="12,3"
                    Visibility="Collapsed" AutomationProperties.AutomationId="RetryButton"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <ItemsControl x:Name="CandidateList" VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <Border BorderBrush="#C8CDD3" BorderThickness="1">
                            <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <DockPanel Margin="8,10,8,4" Visibility="{Binding HeaderVisibility}">
                                <Button DockPanel.Dock="Right" Content="{Binding ToggleText}" Click="ToggleGroup_Click"
                                        Padding="8,1" FontSize="11"/>
                                <TextBlock Text="{Binding Text}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <CheckBox IsChecked="{Binding IsSelected}" Margin="12,3" Visibility="{Binding ItemVisibility}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SubText}" FontSize="11" Foreground="#6B7480" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Tag}" FontSize="11" Foreground="#9A6700" TextWrapping="Wrap"
                                               Visibility="{Binding TagVisibility}"/>
                                </StackPanel>
                            </CheckBox>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl x:Name="ResultList" Visibility="Collapsed">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <Border BorderBrush="#C8CDD3" BorderThickness="1">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="10,6">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{Binding Target, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding StatusText, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" Visibility="{Binding DetailVisibility}"/>
                            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="#C0392B" FontSize="11"
                                       Visibility="{Binding ErrorVisibility}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="Note" TextWrapping="Wrap" Foreground="#6B7480"/>
            <TextBlock x:Name="CountText" Margin="0,2,0,0"/>
            <TextBlock x:Name="ExpectedText"/>
            <TextBlock x:Name="ModeNote" TextWrapping="Wrap" Foreground="#6B7480" FontSize="11" Margin="0,2,0,0"/>
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="False">
            <Button x:Name="SelectReservedButton" Click="SelectReserved_Click" DockPanel.Dock="Left" Padding="10,4"
                    AutomationProperties.AutomationId="SelectReservedButton"/>
            <Button x:Name="DeselectAllButton" Click="DeselectAll_Click" DockPanel.Dock="Left" Padding="10,4" Margin="8,0,0,0"
                    AutomationProperties.AutomationId="DeselectAllButton"/>
            <Button x:Name="CloseButton" Click="Close_Click" DockPanel.Dock="Right" Padding="14,4" Margin="8,0,0,0"
                    AutomationProperties.AutomationId="CloseButton"/>
            <Button x:Name="RunButton" Click="Run_Click" DockPanel.Dock="Right" Padding="14,4"
                    AutomationProperties.AutomationId="RunButton"/>
        </DockPanel>
    </Grid>
</Window>
